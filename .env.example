APP_NAME=Motorcycle Dashboard API
APP_VERSION=0.1.0

# Camera stream URLs (camera 1 = front, camera 2 = rear)
CAMERA_1_URL=http://192.168.1.12/camera/stream
CAMERA_2_URL=http://192.168.1.6/camera/stream

# SQLite database path (relative to project root)
DATABASE_PATH=data/motorcycle.db

# Default number of newest images and videos returned by the gallery API
GALLERY_ITEMS_LIMIT=50

# Default number of newest trips returned by the trip-history API
TRIP_HISTORY_ITEMS_LIMIT=50
